{
  "schema_version": "forgeatl.compute-fabric.v1",
  "milestone": "FORGE-ATL.2A",
  "activation": {
    "job_execution_enabled": false,
    "resource_provisioning_enabled": false,
    "training_enabled": false,
    "teacher_enabled": false,
    "production_binding_enabled": false
  },
  "provider_types": [
    "cpu",
    "gpu",
    "npu",
    "qpu"
  ],
  "location_types": [
    "physical",
    "cloud"
  ],
  "requirement_contract": {
    "required": [
      "request_id",
      "requester_id",
      "workload_type",
      "capabilities",
      "memory_gb_min",
      "precision",
      "latency_class",
      "locality",
      "max_cost_inr",
      "estimated_duration_minutes",
      "priority"
    ],
    "forbidden_hardware_fields": [
      "gpu_model",
      "cpu_model",
      "npu_model",
      "qpu_backend",
      "vendor",
      "provider_id",
      "node_id",
      "cuda_device",
      "device_index"
    ],
    "locality_values": [
      "any",
      "physical",
      "cloud"
    ],
    "priority_values": [
      "low",
      "normal",
      "high",
      "critical"
    ]
  },
  "node_contract": {
    "required": [
      "node_id",
      "provider_type",
      "location_type",
      "display_name",
      "capabilities",
      "memory_gb",
      "availability",
      "execution_enabled",
      "health",
      "telemetry",
      "cost"
    ],
    "availability_values": [
      "unknown",
      "declared",
      "available",
      "busy",
      "offline",
      "future"
    ]
  },
  "telemetry_contract": {
    "required": [
      "observed_at",
      "source",
      "load_percent",
      "memory_used_gb",
      "memory_total_gb",
      "temperature_c"
    ],
    "nullable_metrics": [
      "load_percent",
      "memory_used_gb",
      "temperature_c"
    ],
    "health_values": [
      "unknown",
      "healthy",
      "degraded",
      "offline",
      "future"
    ]
  },
  "discovery_contract": {
    "read_only": true,
    "candidate_is_not_assignment": true,
    "candidate_is_not_provisioning": true,
    "candidate_is_not_execution_authority": true
  }
}