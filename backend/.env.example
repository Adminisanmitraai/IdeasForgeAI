APP_NAME=IdeasForgeAI
APP_ENV=development
PORT=8100
PHASE=26A

# Text models; explicit deployment overrides take precedence over application defaults.
OPENAI_MODEL=gpt-6-luna
OPENAI_VOICE_RESPONSE_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6-luna
# Separate audio model; migrate in a dedicated, audio-validated change before 2027-02-26.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
